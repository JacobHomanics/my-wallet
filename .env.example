EXPO_PUBLIC_APP_ORIGIN=
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_APP_SECRET=
# Client ID from Privy Dashboard → App clients (required for native). Do not use app secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_PRIVY_WEB_CLIENT_ID=
EXPO_PUBLIC_PRIVY_MOBILE_CLIENT_ID=
# Key quorum ID from Privy Dashboard → Wallet infrastructure → Authorization keys
EXPO_PUBLIC_PRIVY_SIGNER_ID=
EXPO_PUBLIC_ALCHEMY_API_KEY=
EXPO_PUBLIC_CONVEX_URL=
# Stripe Crypto Onramp (embedded widget). Publishable key only — never put the secret here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Base mainnet CashBox Points ERC-20 (must match Convex REWARD_TOKEN_ADDRESS).
EXPO_PUBLIC_REWARD_TOKEN_ADDRESS=0xc534791fecf402c8d68e03d5fc724f710802dfcd

# Convex server env (set via `npx convex env set`, not EXPO_PUBLIC_*):
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_AUTHORIZATION_PRIVATE_KEY=wallet-auth:...
# PRIVY_EARN_VAULT_ID=          # From Privy Dashboard → Wallet infrastructure → Earn
# ALCHEMY_API_KEY=
# NEYNAR_API_KEY=
# STRIPE_SECRET_KEY=sk_test_...
# TREASURY_KEYSTORE_PASSWORD=
# CASHBACK_KEYSTORE_PASSWORD=
# REWARD_TOKEN_ADDRESS=0x4ed932ac83f77a5d4f3d950ab9ba90882ed06e55
# REWARD_CHAIN_ID=8453
#
# Reward + cashback conversion live in convex/config/app.config.ts (served via appConfig.getPublic).
# Treasury private key is an encrypted keystore file (password in Convex env):
# - convex/keystores/treasury.json  (create with `pnpm keystore:treasury`)
