{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "resolveJsonModule": true,
    "jsx": "react-native",
    "types": ["react", "react-native"],
    "strict": true,
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"]
    }
  },
  "exclude": ["dist", "extension", "convex/_generated"]
}
