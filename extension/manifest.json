{
  "manifest_version": 3,
  "name": "Cashbox",
  "description": "Cashbox wallet — send, receive, and manage crypto from Chrome.",
  "version": "1.0.0",
  "icons": {
    "16": "favicon.png",
    "48": "icon-192.png",
    "128": "icon-192.png"
  },
  "action": {
    "default_title": "Cashbox",
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*/*", "wss://*/*"]
}
